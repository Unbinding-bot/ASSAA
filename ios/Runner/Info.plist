<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Assaa</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>assaa</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Network permissions (required for UDP streaming + WebSocket to ESP32) ── -->

	<!-- Local network access: needed for UDP broadcast (piezo frames) and
	     WebSocket connections to the ESP32-C3 SoftAP on the local subnet.
	     iOS 14+ requires this key — without it the OS silently blocks all
	     connections to local IP addresses. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>ASSAA connects to ESP32-C3 sensor nodes on the local Wi-Fi network to stream acoustic data and send control commands.</string>

	<!-- Bonjour service types: iOS requires you to declare every zero-conf /
	     mDNS service type your app browses or advertises, even if you only
	     use raw UDP/TCP. Listing the generic types here satisfies the
	     NSLocalNetworkUsageDescription requirement on all iOS 14+ devices. -->
	<key>NSBonjourServices</key>
	<array>
		<!-- Raw UDP data stream from ESP32 piezo ADC (port 9000) -->
		<string>_assaa-udp._udp</string>
		<!-- WebSocket control channel to the ESP32 gateway (port 81) -->
		<string>_assaa-ws._tcp</string>
	</array>

	<!-- Microphone: not used for audio recording, but dart:io UDP socket
	     binding on iOS can trigger the microphone entitlement check on some
	     builds. Providing the key prevents a crash if iOS prompts for it. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>ASSAA reads acoustic data from external piezo sensors over Wi-Fi — the device microphone is not used.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
